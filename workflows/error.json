      "name": "error:alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Builds the owner alert for a failed run (design section 17). Long digit runs are masked, so a\n// phone number inside an error message doesn't reach Slack or email in full.\nconst e = $input.first().json;\nconst mask = (s) => String(s || '').replace(/\\d{7,}/g, (d) => '*'.repeat(d.length - 4) + d.slice(-4));\nconst wf = (e.workflow && e.workflow.name) || 'unknown workflow';\nconst ex = (e.execution && e.execution.id) || (e.trigger && 'trigger') || '?';\nconst err = (e.execution && e.execution.error) || (e.trigger && e.trigger.error) || {};\nconst node = (e.execution && e.execution.lastNodeExecuted) || err.node && err.node.name || '';\nconst text = ':warning: Run failed: *' + wf + '* (execution ' + ex + ')' + (node ? ', at node ' + node : '') + '\\n' +\n  mask(err.message || 'no error message').slice(0, 500);\nreturn [{ json: { op: 'post', channel: $env.SLACK_CHANNEL_ID, text, subject: 'n8n run failed: ' + wf, plain: text.replace(/[*:]/g, '') } }];"
      }
    },
    {
