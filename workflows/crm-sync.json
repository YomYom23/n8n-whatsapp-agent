    {
      "id": "4a63aeef-e343-4a3e-b6bf-d28bac022621",
      "name": "deal:input",
      "parameters": {
        "jsCode": "const p = $('crm:plan').first().json;\nconst tryJson = (n) => { try { return $(n).first().json; } catch (e) { return null; } };\nlet contactId = p.contact_id;\nconst found = tryJson('hubspot: find contact');\nif (!contactId && found && found.contact_id) contactId = found.contact_id;\nconst created = tryJson('hubspot: create contact');\nif (!contactId && created) {\n  if (!created.ok) throw new Error('hubspot create_contact: ' + JSON.stringify(created.error || created).slice(0, 300));\n  contactId = created.contact_id;\n}\nconst stageId = p.stage === 'booked' ? $env.HUBSPOT_STAGE_BOOKED : $env.HUBSPOT_STAGE_ENQUIRY;\nconst req = p.dealAction === 'create' ? { op: 'create_deal', contact_id: contactId, stage: stageId, name: 'WhatsApp ' + p.phone.slice(-4) + ' ' + p.now.slice(0, 10) }\n  : p.dealAction === 'move' ? { op: 'move_deal', deal_id: p.deal_id, stage: stageId } : null;\nreturn [{ json: { action: p.dealAction, contact_id: contactId, req } }];"
      },
