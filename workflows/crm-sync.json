    {
      "id": "2a3fc07f-46e4-4b84-b64e-188123547ff9",
      "name": "crm:log-input",
      "parameters": {
        "jsCode": "const p = $('crm:plan').first().json;\n// written here, not through log: log starts crm-sync, so calling it back would make a loop\nreturn [{ json: { logged_at: p.now, wa_id: p.wa_id, direction: 'event', author: 'system', kind: 'crm_' + p.stage,\n  text: $('deal:input').first().json.action, execution_id: String($execution.id) } }];"
      },
      "position": [
        3960,
        -200
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "d4facfaf-f85c-4934-a10a-cc9231696c1c",
      "name": "crm:plan",
      "parameters": {
        "jsCode": "// @lib crm\n// generated from lib/ by scripts/build_code_nodes.js: edit lib/, not this region\nconst __lib = {};\n__lib['crm'] = (function () {\n  const module = { exports: {} };\n  const exports = module.exports;\n  const require = (p) => __lib[String(p).replace(/^\\.\\//, '')];\n  'use strict';\n  // HubSpot target state (design section 15). Pure: the caller does the HubSpot work.\n\n  const EVENTS = ['enquiry', 'booked'];\n\n  // conversation: the conversations row (stage, hubspot_deal_id, deal_stage).\n  // event: 'enquiry' or 'booked'. opts.onDnc: the number is on do-not-contact.\n  // Returns { wantContact, dealAction: 'create' | 'move' | 'none', stage: 'enquiry' | 'booked' | null }.\n  // A contact already stored is found again by the caller; wantContact only says one may exist.\n  function targetState(conversation, event, opts) {\n    if (!EVENTS.includes(event)) throw new Error('unknown crm event: ' + event);\n    const onDnc = Boolean(opts && opts.onDnc);\n    if (onDnc || conversation.stage === 'closed') {\n      return { wantContact: false, dealAction: 'none', stage: null };\n    }\n    const stage = event;\n    const dealId = conversation.hubspot_deal_id;\n    const current = conversation.deal_stage;\n    let dealAction;\n    if (!dealId) dealAction = 'create';\n    else if (stage === 'enquiry' && current === 'booked') dealAction = 'create'; // a new enquiry\n    else if (current === stage) dealAction = 'none';\n    else dealAction = 'move';\n    return { wantContact: true, dealAction, stage };\n  }\n\n  module.exports = { targetState };\n  return module.exports;\n})();\nconst { targetState } = __lib['crm'];\n// @end-lib\nconst i = $('When Executed by Another Workflow').first().json;\nconst conv = $('conversations: get').all().map((x) => x.json).find((c) => c.wa_id) || null;\nconst onDnc = $('do_not_contact: get').all().some((x) => x.json.wa_id === i.wa_id);\nif (!conv) return [{ json: { sync: false, why: 'no conversation' } }];\nconst t = targetState(conv, i.event, { onDnc });\nreturn [{ json: { sync: t.wantContact, ...t, wa_id: i.wa_id, phone: '+' + i.wa_id, event: i.event, now: i.now,\n  contact_id: conv.hubspot_contact_id || '', deal_id: conv.hubspot_deal_id || '' } }];"
      },
      "position": [
        660,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
    {
      "id": "77b10621-57d1-4ec0-876b-51c8c3eb3178",
      "name": "crm:row",
      "parameters": {
        "jsCode": "const p = $('crm:plan').first().json;\nconst d = $('deal:input').first().json;\nconst tryJson = (n) => { try { return $(n).first().json; } catch (e) { return null; } };\nlet dealId = p.deal_id;\nconst created = tryJson('hubspot: create deal');\nconst moved = tryJson('hubspot: move deal');\nconst r = d.action === 'create' ? created : d.action === 'move' ? moved : { ok: true };\nif (!r || !r.ok) throw new Error('hubspot ' + d.action + '_deal: ' + JSON.stringify((r && r.error) || r).slice(0, 300));\nif (d.action === 'create') dealId = r.deal_id;\nreturn [{ json: { wa_id: p.wa_id, hubspot_contact_id: d.contact_id, hubspot_deal_id: dealId, deal_stage: d.action === 'none' ? (p.stage) : p.stage } }];"
      },
      "position": [
        3300,
        -100
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
