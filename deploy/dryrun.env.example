# Copy to deploy/dryrun.env (git-ignored). The dry-run instance has no public URL and talks
# only to the mock server, so the Meta, Slack, Google and HubSpot values are placeholders
# that the fake adapters and the mock server accept.

# --- n8n ---------------------------------------------------------------
# Generate once and keep it: openssl rand -hex 32. Losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=change-me
BUSINESS_TZ=America/New_York

# --- Meta (WhatsApp Cloud API) -----------------------------------------
META_APP_SECRET=dryrun-meta-secret
META_VERIFY_TOKEN=dryrun-verify-token
META_PHONE_NUMBER_ID=100000000000000
META_GRAPH_VERSION=v25.0
META_TEMPLATE_NAME=enquiry_update
META_TEMPLATE_LANG=en_US

# --- Slack -------------------------------------------------------------
SLACK_SIGNING_SECRET=dryrun-slack-secret
SLACK_ALLOWED_USERS=UOWNER0001
SLACK_CHANNEL_ID=CDRYRUN001

# --- Google ------------------------------------------------------------
GOOGLE_CALENDAR_ID=dryrun-calendar
FACTS_SHEET_ID=dryrun-facts
LOG_SHEET_ID=dryrun-log

# --- HubSpot -----------------------------------------------------------
HUBSPOT_PIPELINE_ID=default
HUBSPOT_STAGE_ENQUIRY=enquiry
HUBSPOT_STAGE_BOOKED=booked

# --- Anthropic ---------------------------------------------------------
HAIKU_MODEL=claude-haiku-5-5
HAIKU_MAX_TOKENS=400

# --- Alerts ------------------------------------------------------------
ALERT_EMAIL=alerts@example.com

# --- Dry-run only ------------------------------------------------------
# Shared secret the replay harness sends to ingress-replay and the mock control API.
REPLAY_SECRET=change-me
# Where n8n reaches the mock server on the Compose network.
MOCK_URL=http://mock:8765

# --- Credentials ---------------------------------------------------------
# The dry-run instance needs the same credential names as live, so workflow files match.
# Their secrets can be dummies, since every call goes to the mock server, except:
# TypeSafe AI API: created by scripts/deploy_workflows.py with n8n import:credentials, with
#   baseUrl set to MOCK_URL (the public API refuses that hidden field; spike 1).
