# Copy to deploy/live.env (git-ignored) and fill in. Never commit live.env.

# --- n8n ---------------------------------------------------------------
# Generate once and keep it: openssl rand -hex 32. Losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=change-me
# Public host and base URL that Meta and Slack call. During development: the ngrok domain.
N8N_HOST=example.ngrok-free.app
WEBHOOK_URL=https://example.ngrok-free.app/
BUSINESS_TZ=America/New_York

# --- Compose and Caddy -------------------------------------------------
# Development (ngrok -> Caddy -> n8n): Caddy serves plain HTTP on 127.0.0.1:8080,
# ngrok terminates HTTPS, so there are two proxies in front of n8n.
#   Run the tunnel with: ngrok http 8080 --url https://<your-domain>
SITE_ADDRESS=:80
CADDY_BIND=127.0.0.1
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=8443
N8N_PROXY_HOPS=2
# Server: SITE_ADDRESS=<hostname>, CADDY_BIND=0.0.0.0, CADDY_HTTP_PORT=80,
# CADDY_HTTPS_PORT=443, N8N_PROXY_HOPS=1.

# --- Meta (WhatsApp Cloud API) -----------------------------------------
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WhatsApp Manager > Account tools). Only the doctor workflow reads it.
META_WABA_ID=
META_GRAPH_VERSION=v25.0
META_TEMPLATE_NAME=enquiry_update
META_TEMPLATE_LANG=en_US

# --- Twilio route (stand-in while Meta's own number can't send) ---------
# WA_PROVIDER=twilio sends through Twilio instead of Meta. Point the Twilio WhatsApp Sandbox's
# "When a message comes in" URL at https://<N8N_HOST>/webhook/ingress-twilio (method POST).
# The Auth Token checks Twilio's signature on each request, so it lives here as well as in the
# "Twilio" credential (Basic Auth: user = Account SID, password = Auth Token).
WA_PROVIDER=meta
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sandbox's number, as shown on its Console page, e.g. +14155238886
TWILIO_WHATSAPP_FROM=
# Content SID (HX...) of an approved template for Send template; the sandbox has sample templates
TWILIO_TEMPLATE_SID=
# Only if Twilio calls a different URL than WEBHOOK_URL + webhook/ingress-twilio
# TWILIO_WEBHOOK_URL=

# --- Slack -------------------------------------------------------------
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USERS=
SLACK_CHANNEL_ID=

# --- Google ------------------------------------------------------------
GOOGLE_CALENDAR_ID=
FACTS_SHEET_ID=
LOG_SHEET_ID=

# --- HubSpot -----------------------------------------------------------
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_ENQUIRY=
HUBSPOT_STAGE_BOOKED=

# --- Anthropic ---------------------------------------------------------
HAIKU_MODEL=claude-haiku-5-5
HAIKU_MAX_TOKENS=400

# --- Alerts ------------------------------------------------------------
ALERT_EMAIL=

# --- n8n credentials to create in the editor (secrets live there, not here) ---
# Workflow files refer to credentials by name, so use the names in quotes exactly.
# Meta:      Header Auth, "Authorization: Bearer <system-user access token>" (does not expire)
# Anthropic: Header Auth, x-api-key
# TypeSafe AI API: API key from console.typesafe.ai/keys (node @typesafe-ai/n8n-nodes-typesafe-ai@0.10.0,
#            installed through Settings > Community nodes; spike 1)
# "Slack" (Slack API, bot token): scopes chat:write, reactions:write, channels:history or groups:history;
#            event subscription message.channels or message.groups; interactivity URL
# "Google Calendar" (Google Calendar OAuth2 API): calendar.events, calendar.freebusy
# "Google Sheets" (Google Sheets OAuth2 API): spreadsheets. The log sheet needs a tab named "log".
# "HubSpot" (listed as "HubSpot Service Key" in the editor, type hubspotAppToken; not "HubSpot API", which sends a retired hapikey), private app token: crm.objects.contacts.read/write, crm.objects.deals.read/write
# "SMTP" (SMTP): the error workflow's email fallback to ALERT_EMAIL
# "Twilio" (Basic Auth): Account SID and Auth Token; only needed with WA_PROVIDER=twilio
